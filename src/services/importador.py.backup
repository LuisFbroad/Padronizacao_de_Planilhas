from pathlib import Path
import re
import unicodedata

import pandas as pd
from sqlalchemy import func
from sqlalchemy.dialects.postgresql import insert as pg_insert

from src.database.connection import SessionLocal
from src.database.models import Area, Pessoa, Indicacao, Processo

PASTA_DADOS = Path("__Planilhas_Padrao__")


COLUNAS_INDICACAO = {
    "INDICACAO PRIMARIA": "Primária",
    "INDICACAO SECUNDARIA": "Secundária",
    "INDICACAO TERCIARIA": "Terciária",
    "INDICACAO QUARTERNARIA": "Quaternária",
    "INDICACAO QUATERNARIA": "Quaternária",
    "INDICACAO FINAL": "Final",
}


AREAS_ARQUIVOS = {
    "CIV": {
        "nome": "Civil",
        "alternativas": ["Civil", "Cível"],
    },
    "PREV": {
        "nome": "Previdencia",
        "alternativas": [
            "Previdencia",
            "Previdência",
            "Previdenciário",
            "Previdenciária",
        ],
    },
    "PROJ": {
        "nome": "Projeto",
        "alternativas": ["Projeto", "Projetos"],
    },
    "REV": {
        "nome": "Restituição",
        "alternativas": [
            "Restituição",
            "Restituicao",
            "Revisão",
            "Revisao",
        ],
    },
    "TRAB": {
        "nome": "Trabalhista",
        "alternativas": ["Trabalhista"],
    },
}


def normalizar_texto(valor):
    if valor is None:
        return ""

    texto = str(valor).strip()
    texto = unicodedata.normalize("NFKD", texto)
    texto = "".join(
        caractere for caractere in texto if not unicodedata.combining(caractere)
    )

    texto = texto.upper()
    texto = re.sub(r"[^A-Z0-9]+", " ", texto)

    return " ".join(texto.split())


def normalizar_nome(nome):
    if nome is None or pd.isna(nome):
        return ""

    return " ".join(str(nome).strip().split())


def limpar_valor(valor):
    if valor is None:
        return None

    try:
        if pd.isna(valor):
            return None
    except (TypeError, ValueError):
        pass

    if isinstance(valor, float) and valor.is_integer():
        valor = int(valor)

    texto = str(valor).strip()

    if not texto or texto.lower() in {"nan", "none", "null"}:
        return None

    return texto


def normalizar_coluna(coluna):
    return normalizar_texto(coluna)


def preparar_linha(linha):
    dados = {}

    for coluna, valor in linha.items():
        chave = normalizar_coluna(coluna)

        if chave:
            dados[chave] = valor

    return dados


def obter_campo(dados, alternativas):
    for alternativa in alternativas:
        chave = normalizar_coluna(alternativa)

        if chave in dados:
            valor = limpar_valor(dados[chave])

            if valor is not None:
                return valor

    return None


def obter_quantidade(dados):
    valor = obter_campo(
        dados,
        ["Qnt.", "Quantidade", "Qnt"],
    )

    if valor is None:
        return 0

    try:
        quantidade = float(str(valor).strip().replace(",", "."))

        if quantidade < 0 or not quantidade.is_integer():
            return 0

        return int(quantidade)

    except (TypeError, ValueError, OverflowError):
        return 0


def identificar_area(nome_arquivo):
    nome = nome_arquivo.upper()

    for sigla, configuracao in AREAS_ARQUIVOS.items():
        if f"_{sigla}_" in nome:
            return configuracao

    return None


def buscar_area(session, configuracao):
    alternativas = configuracao["alternativas"]

    nomes_normalizados = {normalizar_texto(nome) for nome in alternativas}

    areas = session.query(Area).all()

    for area in areas:
        if normalizar_texto(area.nome) in nomes_normalizados:
            return area

    area = Area(nome=configuracao["nome"])
    session.add(area)
    session.flush()

    return area


def buscar_ou_criar_pessoa(session, nome):
    nome = normalizar_nome(nome)

    if not nome:
        return None

    nome_normalizado = normalizar_texto(nome)

    if not nome_normalizado:
        return None

    for objeto in session.new:
        if isinstance(objeto, Pessoa):
            if normalizar_texto(objeto.nome) == nome_normalizado:
                return objeto

    with session.no_autoflush:
        pessoa = (
            session.query(Pessoa)
            .filter(func.upper(func.trim(Pessoa.nome)) == nome.upper().strip())
            .first()
        )

    if pessoa:
        return pessoa

    comando = (
        pg_insert(Pessoa)
        .values(nome=nome)
        .on_conflict_do_nothing(index_elements=[Pessoa.nome])
    )

    session.execute(comando)

    with session.no_autoflush:
        pessoa = (
            session.query(Pessoa)
            .filter(func.upper(func.trim(Pessoa.nome)) == nome.upper().strip())
            .first()
        )

    if pessoa:
        return pessoa

    raise RuntimeError(f"Não foi possível localizar ou cadastrar a pessoa: {nome}")


def obter_processo(dados):
    return obter_campo(
        dados,
        [
            "N do Processo",
            "Nº do Processo",
            "N° do Processo",
            "Numero do Processo",
            "Número do Processo",
            "Processo",
            "PRC/RPV",
        ],
    )


def obter_numero_rpv(dados):
    return obter_campo(
        dados,
        [
            "PRC/RPV",
            "N do Processo",
            "Nº do Processo",
            "N° do Processo",
            "Numero do Processo",
            "Número do Processo",
            "Processo",
        ],
    )


def obter_data(dados):
    """Retorna a data da planilha ou None; nunca infere data pelo nome do arquivo."""
    valor = obter_campo(
        dados,
        [
            "Data",
            "Data do Processo",
            "Data da Indicação",
        ],
    )

    if valor is None:
        return None

    # Valores já lidos como datetime/date não precisam de inferência textual.
    try:
        if isinstance(valor, (pd.Timestamp,)):
            return None if pd.isna(valor) else valor.date()
    except (TypeError, ValueError, OverflowError):
        pass

    texto = str(valor).strip()
    if not texto or texto.lower() in {"nan", "none", "null", "nat"}:
        return None

    # Prioriza formatos ISO, comuns em valores como 2026-08-14 00:00:00.
    formatos = (
        "%Y-%m-%d %H:%M:%S",
        "%Y-%m-%d %H:%M:%S.%f",
        "%Y-%m-%d",
        "%Y-%m-%dT%H:%M:%S",
        "%Y-%m-%dT%H:%M:%S.%f",
    )
    for formato in formatos:
        try:
            return pd.to_datetime(texto, format=formato, errors="raise").date()
        except (TypeError, ValueError, OverflowError):
            continue

    # Para datas em formatos brasileiros, tenta dia/mês/ano.
    try:
        convertido = pd.to_datetime(texto, dayfirst=True, errors="coerce")
        if pd.isna(convertido):
            return None
        return convertido.date()
    except (TypeError, ValueError, OverflowError):
        return None


def obter_indicacoes(dados):
    indicacoes = []

    for coluna, tipo in COLUNAS_INDICACAO.items():
        valor = obter_campo(dados, [coluna])

        if not valor:
            continue

        partes = str(valor).split("/")

        for parte in partes:
            nome = normalizar_nome(parte)

            if not nome:
                continue

            if normalizar_texto(nome) in {
                "NAN",
                "NONE",
                "NULL",
                "N A",
            }:
                continue

            indicacoes.append(
                {
                    "nome": nome,
                    "tipo": tipo,
                }
            )

    return indicacoes


def buscar_ou_criar_processo(
    session,
    area,
    numero,
    data_processo,
    nome_arquivo,
    quantidade,
    chaves_processos_pendentes,
):
    numero = limpar_valor(numero)

    if not numero:
        return False

    chave = (
        area.id,
        normalizar_texto(numero),
    )

    processo_existente = (
        session.query(Processo)
        .filter(
            Processo.area_id == area.id,
            Processo.numero == numero,
        )
        .first()
    )

    if processo_existente:
        # Importação aditiva: não sobrescreve registros já existentes.
        chaves_processos_pendentes.add(chave)
        return False

    if chave in chaves_processos_pendentes:
        return False

    processo = Processo(
        area_id=area.id,
        numero=numero,
        data_processo=data_processo,
        arquivo_origem=nome_arquivo,
        quantidade=quantidade,
    )

    session.add(processo)
    session.flush()

    chaves_processos_pendentes.add(chave)

    return True


def buscar_indicacao_existente(
    session,
    pessoa_id,
    area_id,
    processo,
    tipo,
    data_indicacao,
    nome_arquivo,
):
    consulta = session.query(Indicacao).filter(
        Indicacao.pessoa_id == pessoa_id,
        Indicacao.area_id == area_id,
        Indicacao.tipo_indicacao == tipo,
    )

    if processo:
        consulta = consulta.filter(Indicacao.processo == processo)
    else:
        consulta = consulta.filter(
            Indicacao.processo.is_(None),
            Indicacao.arquivo_origem == nome_arquivo,
        )

        if data_indicacao:
            consulta = consulta.filter(Indicacao.data_indicacao == data_indicacao)
        else:
            consulta = consulta.filter(Indicacao.data_indicacao.is_(None))

    return consulta.first()


def importar_planilha(
    caminho,
    session,
    chaves_indicacoes_pendentes,
    chaves_processos_pendentes,
):
    nome_arquivo = caminho.name
    configuracao = identificar_area(nome_arquivo)

    if not configuracao:
        print(f"[AVISO] Área não identificada: {nome_arquivo}")
        return 0, 0

    area = buscar_area(session, configuracao)

    print()
    print("=" * 80)
    print(f"ARQUIVO: {nome_arquivo}")
    print(f"ÁREA IDENTIFICADA: {area.nome}")
    print("=" * 80)

    df = pd.read_excel(caminho, header=3)

    total_indicacoes = 0
    total_processos = 0
    total_linhas_com_indicacao = 0
    maior_quantidade = 0

    eh_projeto = "PROJ" in nome_arquivo.upper()

    for _, linha in df.iterrows():
        dados = preparar_linha(linha)

        quantidade = obter_quantidade(dados)
        maior_quantidade = max(
            maior_quantidade,
            quantidade,
        )

        numero_processo = obter_processo(dados)
        numero_rpv = obter_numero_rpv(dados)
        data_processo = obter_data(dados)
        indicacoes = obter_indicacoes(dados)

        if eh_projeto and numero_rpv:
            inserido = buscar_ou_criar_processo(
                session=session,
                area=area,
                numero=numero_rpv,
                data_processo=data_processo,
                nome_arquivo=nome_arquivo,
                quantidade=quantidade,
                chaves_processos_pendentes=chaves_processos_pendentes,
            )

            if inserido:
                total_processos += 1

        if not indicacoes:
            continue

        total_linhas_com_indicacao += 1

        # Indicações podem existir sem número de processo em qualquer área.
        # A data continua None quando não está preenchida na planilha.
        processo_indicacao = numero_processo

        for item in indicacoes:
            pessoa = buscar_ou_criar_pessoa(
                session,
                item["nome"],
            )

            if pessoa is None:
                continue

            tipo = item["tipo"]

            chave = (
                pessoa.id,
                area.id,
                processo_indicacao,
                tipo,
                data_processo if not processo_indicacao else None,
                nome_arquivo if not processo_indicacao else None,
            )

            if chave in chaves_indicacoes_pendentes:
                continue

            indicacao_existente = buscar_indicacao_existente(
                session=session,
                pessoa_id=pessoa.id,
                area_id=area.id,
                processo=processo_indicacao,
                tipo=tipo,
                data_indicacao=data_processo,
                nome_arquivo=nome_arquivo,
            )

            if indicacao_existente:
                # Não altera uma indicação já cadastrada; evita sobrescrita silenciosa.
                chaves_indicacoes_pendentes.add(chave)
                continue

            indicacao = Indicacao(
                pessoa_id=pessoa.id,
                area_id=area.id,
                processo=processo_indicacao,
                tipo_indicacao=tipo,
                data_indicacao=data_processo,
                arquivo_origem=nome_arquivo,
                quantidade=quantidade,
            )

            session.add(indicacao)
            chaves_indicacoes_pendentes.add(chave)
            total_indicacoes += 1

    print(f"Linhas com indicação: {total_linhas_com_indicacao}")
    print(f"Maior quantidade Qnt.: {maior_quantidade}")
    print(f"Processos/RPVs novos: {total_processos}")
    print(f"Indicações novas: {total_indicacoes}")

    return total_indicacoes, total_processos


def importar_todas(pasta_origem=None):
    """
    Importa planilhas para o PostgreSQL sem apagar nem sobrescrever registros existentes.

    Indicações sem número de processo são permitidas. Datas ausentes permanecem None;
    o mês não é inferido a partir do nome do arquivo.
    Se nenhuma pasta for informada, usa a pasta padrão antiga.
    """
    from pathlib import Path

    pasta = Path(pasta_origem) if pasta_origem else PASTA_DADOS
    pasta = pasta.expanduser().resolve()

    if not pasta.exists() or not pasta.is_dir():
        raise FileNotFoundError(f"Pasta de origem não encontrada: {pasta}")

    extensoes = {".xlsx", ".xlsm", ".xls"}

    arquivos = sorted(
        (
            arquivo
            for arquivo in pasta.iterdir()
            if arquivo.is_file()
            and arquivo.suffix.lower() in extensoes
            and not arquivo.name.startswith("~$")
        ),
        key=lambda arquivo: arquivo.name.lower(),
    )

    if not arquivos:
        raise FileNotFoundError(
            f"Nenhuma planilha Excel compatível encontrada em:\n{pasta}"
        )

    session = SessionLocal()
    total_indicacoes = 0
    total_processos = 0

    chaves_indicacoes_pendentes = set()
    chaves_processos_pendentes = set()

    try:
        print("=" * 70)
        print("IMPORTAÇÃO DAS PLANILHAS")
        print("=" * 70)
        print(f"Pasta de origem: {pasta}")
        print(f"Arquivos encontrados: {len(arquivos)}")

        for arquivo in arquivos:
            print(f"\nProcessando: {arquivo.name}")

            novas_indicacoes, novos_processos = importar_planilha(
                caminho=arquivo,
                session=session,
                chaves_indicacoes_pendentes=(chaves_indicacoes_pendentes),
                chaves_processos_pendentes=(chaves_processos_pendentes),
            )

            total_indicacoes += novas_indicacoes
            total_processos += novos_processos

        session.commit()

        print("\nIMPORTAÇÃO CONCLUÍDA")
        print(f"Indicações novas: {total_indicacoes}")
        print(f"Processos/RPVs novos: {total_processos}")

        return {
            "arquivos": len(arquivos),
            "indicacoes": total_indicacoes,
            "processos": total_processos,
        }

    except Exception:
        session.rollback()
        raise

    finally:
        session.close()
